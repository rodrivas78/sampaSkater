' ----------------
' TINY SPRITE TEST
' ----------------
' MSX2

FILE "converted.SC4"     ' screen resource
FILE "sprite1_2_5_yellow.spr"   ' resource 0: msx1 sprite set
10 COLOR 15,1,1
20 SCREEN 4, 2, 0 ' screen mode 2 (msx1)
30 REM VY=0:AY=0
40 SCREEN LOAD 0  
50 SPRITE LOAD 1     ' load resource 1 (msx2 sprite set)
60 SPD=5:PX=80:AB=0:AC=0:TW=0
70 AON=0:BON=0:CON=0:AX=240:BX=256:CX=256:DX=220:T=0:AG=0:AF=0:SW=1
80 S% = STICK(0)
90 IF S%=5 THEN D=8 ELSE IF S%=1 THEN D=16 ELSE D=0
100 ON STRIG GOSUB 360
110 IF D=0 AND S%=3 THEN SPD=SPD+.5
120 IF D=0 AND S%=7 THEN SPD=SPD-.5
130 IF SPD<0 THEN SPD=0
140 PX=80+(SPD-5)*4
150 T=T+1
160 IF T<70 THEN 190
170 T=0
180 REM IF AON=0 AND BON=0 THEN IF SW=0 THEN AON=1:AX=240:SW=1 ELSE BON=1:BX=256:SW=0
182 IF AON=0 AND BON=0 AND CON=0 AND DON=0 THEN ON SW GOTO 183,184,185,186
183 AON=1:AX=256:SW=2:TW=TW+1:GOTO 190
184 BON=1:BX=256:SW=3:GOTO 190
185 CON=1:CX=256:SW=4:GOTO 190
186 DON=1:DX=240:SW=1:GOTO 190
190 SCREEN SCROLL 3
200 IF VY<0 THEN VY=VY+AY : AY=AY+.7 : D=16 : STRIG(0) OFF : STRIG(0) OFF ELSE VY=0:AY=0:STRIG(0) ON
210 IF PX<30 THEN PX=30 ELSE IF PX>110 THEN PX=110
220 PUT SPRITE 0,(PX,137+VY),,0+D
230 PUT SPRITE 1,(PX,137+VY),,1+D
240 PUT SPRITE 2,(PX+16,137+VY),,2+D
250 PUT SPRITE 3,(PX+16,137+VY),,3+D
260 PUT SPRITE 4,(PX,153+VY),,4+D
270 PUT SPRITE 5,(PX,153+VY),,5+D
280 PUT SPRITE 6,(PX+16,153+VY),,6+D
290 PUT SPRITE 7,(PX+16,153+VY),,7+D
300 REM FOR F=0 TO (150-SPD*10):NEXT F
310 FOR F=0 TO 100:NEXT F
320 GOSUB 380
330 GOSUB 460
340 GOSUB 540
342 GOSUB 620
344 REM ON TW 
350 GOTO 80
360 D=16:AY=-4:VY=-1.2:RETURN
370 END
380 REM HIDRANTE
385 IF AON=0 THEN 440
390 AX=AX-5
400 IF AX<-16 THEN AON=0:GOTO 440
405 IF TW=3 THEN IF CX<200 THEN DON=1:DX=240:PUT SPRITE 12,(0,0),0,0:PUT SPRITE 13,(0,0),0,0
410 PUT SPRITE 8,(AX,154),1,24
420 PUT SPRITE 9,(AX,154),6,25
430 RETURN
440 PUT SPRITE 8,(0,0),0,0:PUT SPRITE 8,(0,0),0,0
450 RETURN
460 REM PASSARO
465 IF BON=0 THEN 520
470 BX=BX-5
480 IF BX<-16 THEN BON=0:GOTO 520
490 AB=AB+1:IF AB<2 THEN 500 ELSE AB=0:AF=AF+AD:IF AF=2 THEN AD=-1 ELSE IF AF=0 THEN AD=1
500 PUT SPRITE 10,(BX,131),1,26+AF
510 RETURN
520 PUT SPRITE 10,(0,0),0,0
530 RETURN
540 REM PNEU
545 IF CON=0 THEN 600
550 CX=CX-5
560 IF CX<-16 THEN CON=0:GOTO 600
562 IF TW=2 THEN IF CX<200 THEN BON=1:BX=256:PUT SPRITE 10,(0,0),0,0:TW=TW+1
564 REM IF TW=3 THEN IF CX<200 THEN AON=1:AX=240:PUT SPRITE 8,(0,0),0,0:PUT SPRITE 9,(0,0),0,0
566 REM IF TW=3 THEN IF CX<200 THEN DON=1:DX=240:PUT SPRITE 12,(0,0),0,0:PUT SPRITE 13,(0,0),0,0
570 REM AC=AC+1:IF AC<2 THEN 580 ELSE AC=0:AG=AG+1:IF AG>3 THEN AG=0
575 AC=AC+1:IF AC<2 THEN 580 ELSE AC=0:AG=AG+1:IF AG>1 THEN AG=0
580 PUT SPRITE 11,(CX,155),1,29+AG
590 RETURN
600 PUT SPRITE 11,(0,0),0,0
610 RETURN
620 REM COBRA
625 DX=DX-5
630 IF DX<-32 THEN DON=0:GOTO 670
640 AB=AB+1:IF AB<3 THEN 650 ELSE AB=0:AF=AF+1:IF AF>1 THEN AF=0
650 REM PUT SPRITE 12,(DX,153),1,33+AF:PUT SPRITE 13,(DX+16,153),1,34+AF
655 PUT SPRITE 12,(DX,153),1,31+AF:PUT SPRITE 13,(DX+16,153),1,33+AF
660 RETURN
670 PUT SPRITE 12,(0,0),0,0:PUT SPRITE 13,(0,0),0,0
680 RETURN
690 IF CX<200 THEN BON=1:BX=256:PUT SPRITE 10,(0,0),0,0:GOTO 570
700 IF CX<200 THEN AON=1:AX=240:PUT SPRITE 8,(0,0),0,0:PUT SPRITE 9,(0,0),0,0:GOTO 570
710 IF CX<200 THEN DON=1:DX=240:PUT SPRITE 13,(0,0),0,0:GOTO 570
720 REM TRATAMENTO DE COLISÕES
722 REM TOCA SOM
730 PUT SPRITE 
740 RETURN 