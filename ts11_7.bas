' MSX2

FILE "converted.SC4"     ' screen resource
FILE "sprite1_2_5_yellow.spr"   ' resource 0: msx1 sprite set
10 COLOR 15,1,1
20 SCREEN 4, 2, 0 ' screen mode 2 (msx1)
30 REM VY=0:AY=0
40 SCREEN LOAD 0  
50 SPRITE LOAD 1     ' load resource 1 (msx2 sprite set)
60 SPD=5:PX=80:AB=0:AC=0:TW=0
70 AON=0:BON=0:CON=0:AX=240:BX=256:CX=256:DX=220:T=0:AG=0:AF=0:SW=1
75 REM LOCATE 10, 10 : PRINT "SCORE:"
80 S% = STICK(0)
90 IF S%=5 THEN D=8 ELSE IF S%=1 THEN D=16 ELSE D=0
100 ON STRIG GOSUB 430
110 IF D=0 AND S%=3 THEN SPD=SPD+.5
120 IF D=0 AND S%=7 THEN SPD=SPD-.5
130 IF SPD<0 THEN SPD=0
140 PX=80+(SPD-5)*4
150 T=T+1
160 IF T<70 THEN 240
170 T=0
180 REM IF AON=0 AND BON=0 THEN IF SW=0 THEN AON=1:AX=240:SW=1 ELSE BON=1:BX=256:SW=0
190 IF AON=0 AND BON=0 AND CON=0 AND DON=0 THEN ON SW GOTO 200,210,220,230
200 AON=1:AX=256:SW=2:TW=TW+1:GOTO 240
210 BON=1:BX=256:SW=3:GOTO 240
220 CON=1:CX=256:SW=4:GOTO 240
230 DON=1:DX=240:SW=1:GOTO 240
240 REM SCREEN SCROLL 3
250 IF VY<0 THEN VY=VY+AY : AY=AY+.7 : D=16 : STRIG(0) OFF : STRIG(0) OFF ELSE VY=0:AY=0:STRIG(0) ON
260 IF PX<30 THEN PX=30 ELSE IF PX>110 THEN PX=110
270 PUT SPRITE 0,(PX,137+VY),,0+D
280 PUT SPRITE 1,(PX,137+VY),,1+D
290 PUT SPRITE 2,(PX+16,137+VY),,2+D
300 PUT SPRITE 3,(PX+16,137+VY),,3+D
310 PUT SPRITE 4,(PX,153+VY),,4+D
320 PUT SPRITE 5,(PX,153+VY),,5+D
330 PUT SPRITE 6,(PX+16,153+VY),,6+D
340 PUT SPRITE 7,(PX+16,153+VY),,7+D
350 REM FOR F=0 TO (150-SPD*10):NEXT F
352 SN% = COLLISION(6,8):IF SN% >= 0 THEN GOSUB 900
353 SN% = COLLISION(6,10):IF SN% >= 0 THEN GOSUB 900
354 SN% = COLLISION(0,10):IF SN% >= 0 THEN GOSUB 900
355 SN% = COLLISION(6,11):IF SN% >= 0 THEN GOSUB 900
356 SN% = COLLISION(6,10):IF SN% >= 0 THEN GOSUB 900
359 REM PRINT SN%
360 FOR F=0 TO 100:NEXT F
370 GOSUB 450
380 GOSUB 550
390 GOSUB 640
400 GOSUB 770
410 REM ON TW 
420 GOTO 80
430 D=16:AY=-4:VY=-1.2:RETURN
440 END
450 REM HIDRANTE
460 IF AON=0 THEN 530
470 AX=AX-5
480 IF AX<-16 THEN AON=0:GOTO 530
490 IF TW=3 THEN IF CX<200 THEN DON=1:DX=240:PUT SPRITE 12,(0,0),0,0:PUT SPRITE 13,(0,0),0,0
500 PUT SPRITE 8,(AX,154),1,24
510 PUT SPRITE 9,(AX,154),6,25
520 RETURN
530 PUT SPRITE 8,(0,0),0,0:PUT SPRITE 8,(0,0),0,0
540 RETURN
550 REM PASSARO
560 IF BON=0 THEN 620
570 BX=BX-5
580 IF BX<-16 THEN BON=0:GOTO 620
590 AB=AB+1:IF AB<2 THEN 600 ELSE AB=0:AF=AF+AD:IF AF=2 THEN AD=-1 ELSE IF AF=0 THEN AD=1
600 PUT SPRITE 10,(BX,131),1,26+AF
610 RETURN
620 PUT SPRITE 10,(0,0),0,0
630 RETURN
640 REM PNEU
650 IF CON=0 THEN 750
660 CX=CX-5
670 IF CX<-16 THEN CON=0:GOTO 750
680 IF TW=2 THEN IF CX<200 THEN BON=1:BX=256:PUT SPRITE 10,(0,0),0,0:TW=TW+1
690 REM IF TW=3 THEN IF CX<200 THEN AON=1:AX=240:PUT SPRITE 8,(0,0),0,0:PUT SPRITE 9,(0,0),0,0
700 REM IF TW=3 THEN IF CX<200 THEN DON=1:DX=240:PUT SPRITE 12,(0,0),0,0:PUT SPRITE 13,(0,0),0,0
710 REM AC=AC+1:IF AC<2 THEN 580 ELSE AC=0:AG=AG+1:IF AG>3 THEN AG=0
720 AC=AC+1:IF AC<2 THEN 730 ELSE AC=0:AG=AG+1:IF AG>1 THEN AG=0
730 PUT SPRITE 11,(CX,155),1,29+AG
740 RETURN
750 PUT SPRITE 11,(0,0),0,0
760 RETURN
770 REM COBRA
780 DX=DX-5
790 IF DX<-32 THEN DON=0:GOTO 840
800 AB=AB+1:IF AB<3 THEN 810 ELSE AB=0:AF=AF+1:IF AF>1 THEN AF=0
810 REM PUT SPRITE 12,(DX,153),1,33+AF:PUT SPRITE 13,(DX+16,153),1,34+AF
820 PUT SPRITE 12,(DX,153),1,31+AF:PUT SPRITE 13,(DX+16,153),1,33+AF
830 RETURN
840 PUT SPRITE 12,(0,0),0,0:PUT SPRITE 13,(0,0),0,0
850 RETURN
860 IF CX<200 THEN BON=1:BX=256:PUT SPRITE 10,(0,0),0,0:GOTO 710
870 IF CX<200 THEN AON=1:AX=240:PUT SPRITE 8,(0,0),0,0:PUT SPRITE 9,(0,0),0,0:GOTO 710
880 IF CX<200 THEN DON=1:DX=240:PUT SPRITE 13,(0,0),0,0:GOTO 710
890 REM TRATAMENTO DE COLISÕES
900 LINE (0,0)-(80,30),1,BF
905 LOCATE 10,10:PRINT "COLLISION:";SN%
910 REM PUT SPRITE 
920 RETURN